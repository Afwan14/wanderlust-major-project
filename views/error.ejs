<!-- ========================================
     ERROR PAGE
     Displays error messages in a user-friendly format
     ======================================== -->

<!-- Use boilerplate layout template -->
<% layout("/layouts/boilerplate") %>

<!-- Error message container -->
<div class="row mt-3">
  <div class="alert alert-danger col-6 offset-3" role="alert">
    <!-- Error message from error handler -->
    <p class="alert-heading"><%= message %></p>
  </div>
</div>
