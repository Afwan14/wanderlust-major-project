<!-- ========================================
     TOAST NOTIFICATIONS COMPONENT
     Displays temporary success/error notifications using toast style
     ======================================== -->

<%
  const successMsg = Array.isArray(success) ? success : [];
  const errorMsg = Array.isArray(error) ? error : [];
%>

<div id="toast-container"></div>

<div
  id="toast-flash-data"
  data-success="<%= encodeURIComponent(successMsg.length ? String(successMsg) : '') %>"
  data-error="<%= encodeURIComponent(errorMsg.length ? String(errorMsg) : '') %>"
  hidden
></div>

<script src="/JS/toast.js"></script>
