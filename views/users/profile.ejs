<% layout("/layouts/boilerplate") %>
<% if (!currUser) { %>
<div class="container mt-5">
  <p>Please log in to view your profile.</p>
</div>
<% return; %>
<% } %>
<% const profileComplete = !!(currUser.fullName && currUser.phone && currUser.location && currUser.bio && currUser.languages && currUser.work && currUser.education); %>

<head>
  <link rel="stylesheet" href="/css/profile.css" />
</head>

<div class="container profile-page mt-5">
  <div class="row">
    <!-- ================= LEFT SIDEBAR ================= -->
    <div class="col-md-3">
      <h3 class="mb-4">Profile</h3>

      <div class="profile-menu">
        <a
          href="/profile"
          class="profile-menu-item <%= currentPage === '/profile' ? 'active' : '' %>"
        >
          <i class="fa-regular fa-user menu-icon"></i>
          <span>About me</span>
        </a>

        <a
          href="/bookings"
          class="profile-menu-item <%= currentPage.startsWith('/bookings') ? 'active' : '' %>"
        >
          <i class="fa-regular fa-calendar-check menu-icon"></i>
          <span>My Stays</span>
        </a>

        <a
          href="/listings/my"
          class="profile-menu-item <%= currentPage.startsWith('/listings/my') ? 'active' : '' %>"
        >
          <i class="fa-regular fa-building menu-icon"></i>
          <span>My Listings</span>
        </a>

        <% if (hostedCount > 0) { %>
        <a
          href="/bookings/host/reservations"
          class="profile-menu-item <%= currentPage.startsWith('/bookings/host/reservations') ? 'active' : '' %>"
        >
          <i class="fa-regular fa-address-book menu-icon"></i>
          <span>Guest Reservations</span>
        </a>
        <% } %>

        <a
          href="/wishlist"
          class="profile-menu-item <%= currentPage.startsWith('/wishlist') ? 'active' : '' %>"
        >
          <i class="fa-regular fa-heart menu-icon"></i>
          <span>Wishlist</span>
        </a>
      </div>
    </div>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="col-md-6">
      <!-- ===== ABOUT ===== -->
      <div class="profile-section">
        <div class="about-header d-flex align-items-center gap-3 mb-4">
          <h2 class="mb-0">About me</h2>
          <a href="/profile/complete" class="edit-btn">Edit</a>
        </div>

        <div class="profile-card mb-4">
          <div class="profile-avatar-lg">
            <%= currUser.username.charAt(0).toUpperCase() %>
          </div>
          <h4 class="mt-3"><%= currUser.username %></h4>
          <p class="text-muted"><%= hostedCount > 0 ? "Host" : "Guest" %></p>
          <div class="profile-meta-row">
            <span class="member-since">Member since 2026</span>
            <span class="verified-badge">
              <i class="fa-solid fa-shield-halved"></i>
              Verified
            </span>
          </div>
        </div>

        <div class="profile-about mb-4">
          <h5>About</h5>
          <p class="text-muted">
            <%= currUser.bio || "Tell hosts a little about yourself." %>
          </p>
        </div>

        <div class="profile-about mb-4">
          <h5>Basic info</h5>
          <div class="basic-info-card">
            <div class="basic-info-grid">
              <div class="basic-info-item">
                <i class="fa-regular fa-id-card basic-info-icon"></i>
                <div>
                  <span class="basic-info-label">Name</span>
                  <p class="basic-info-value"><%= currUser.fullName || "Add your full name" %></p>
                </div>
              </div>
              <div class="basic-info-item">
                <i class="fa-solid fa-location-dot basic-info-icon"></i>
                <div>
                  <span class="basic-info-label">Location</span>
                  <p class="basic-info-value"><%= currUser.location || "Add your location" %></p>
                </div>
              </div>
              <div class="basic-info-item">
                <i class="fa-solid fa-language basic-info-icon"></i>
                <div>
                  <span class="basic-info-label">Languages</span>
                  <p class="basic-info-value"><%= currUser.languages || "Add languages you speak" %></p>
                </div>
              </div>
              <div class="basic-info-item">
                <i class="fa-solid fa-briefcase basic-info-icon"></i>
                <div>
                  <span class="basic-info-label">Work</span>
                  <p class="basic-info-value"><%= currUser.work || "Add your work" %></p>
                </div>
              </div>
              <div class="basic-info-item">
                <i class="fa-solid fa-graduation-cap basic-info-icon"></i>
                <div>
                  <span class="basic-info-label">Education</span>
                  <p class="basic-info-value"><%= currUser.education || "Add your education" %></p>
                </div>
              </div>
              <div class="basic-info-item">
                <i class="fa-solid fa-phone basic-info-icon"></i>
                <div>
                  <span class="basic-info-label">Phone</span>
                  <p class="basic-info-value"><%= currUser.phone || "Add your phone number" %></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <hr class="section-divider" />

        <div class="profile-reviews">
          <h5>💬 Reviews I've written</h5>

          <% if (!reviews || reviews.length === 0) { %>
          <p class="text-muted">You haven't written any reviews yet.</p>
          <a href="/reviews" class="reviews-link">View all reviews</a>
          <% } else { %>
          <% reviews.forEach((review, index) => { %>
          <% if (index
          < 2) { %>
          <div class="review-card">
            <div class="d-flex justify-content-between">
              <a href="/listings/<%= review.listing._id %>">
                <strong><%= review.listing.title %></strong>
              </a>
              <span class="review-rating">
                <i class="fa-solid fa-star"></i>
                <%= review.rating %>
              </span>
            </div>
            <p class="mb-0"><%= review.comment %></p>
          </div>
          <% } %>
          <% }) %>
          <% if (reviews.length > 2) { %>
          <a href="/reviews" class="reviews-link">
            View all <%= reviews.length %> reviews
          </a>
          <% } %>
          <% } %>
        </div>
      </div>

    </div>

    <!-- ================= RIGHT SIDEBAR ================= -->
    <div class="col-md-3 mt-5 comp-profile">
      <% if (!profileComplete) { %>
      <div id="completeProfileSidebar" class="complete-profile-card sticky-top">
        <h5>Complete your profile</h5>
        <p class="text-muted">
          Your Wanderlust profile helps hosts and guests get to know you.
        </p>
        <a href="/profile/complete" class="btn btn-danger w-100">
          Get started
        </a>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ================= EDIT PROFILE (CUSTOM MODAL) ================= -->
<div id="profileModal" class="profile-modal">
  <div class="profile-modal-box">
    <div
      class="modal-header d-flex justify-content-between align-items-center mb-3"
    >
      <h2 class="mb-0">Edit Profile</h2>
      <span
        id="closeProfileModal"
        class="close"
      >
        &times;
      </span>
    </div>

    <form id="editProfileForm" method="POST" action="/profile">
      <div class="form-group mb-3">
        <label class="form-label">Username</label>
        <input
          type="text"
          name="username"
          class="form-control"
          value="<%= currUser.username %>"
          required
        />
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Full name</label>
        <input
          type="text"
          name="fullName"
          class="form-control"
          value="<%= currUser.fullName || "" %>"
          placeholder="Your full name"
        />
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Phone</label>
        <input
          type="tel"
          name="phone"
          class="form-control"
          value="<%= currUser.phone || "" %>"
          placeholder="Your phone number"
        />
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Location</label>
        <input
          type="text"
          name="location"
          class="form-control"
          value="<%= currUser.location || "" %>"
          placeholder="City, Country"
        />
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Bio</label>
        <textarea
          name="bio"
          class="form-control"
          rows="4"
          placeholder="Tell hosts a little about yourself."
        >
<%= currUser.bio || "" %></textarea
        >
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Languages</label>
        <input
          type="text"
          name="languages"
          class="form-control"
          value="<%= currUser.languages || "" %>"
          placeholder="English, Hindi"
        />
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Work</label>
        <input
          type="text"
          name="work"
          class="form-control"
          value="<%= currUser.work || "" %>"
          placeholder="Your role or company"
        />
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Education</label>
        <input
          type="text"
          name="education"
          class="form-control"
          value="<%= currUser.education || "" %>"
          placeholder="Your school or degree"
        />
      </div>

      <div class="d-flex justify-content-end gap-2">
        <button
          type="button"
          id="closeProfileModalBtn"
          class="btn btn-secondary"
        >
          Cancel
        </button>
        <button type="button" id="openConfirmSave" class="btn btn-danger">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= CONFIRM SAVE (BOOTSTRAP MODAL) ================= -->
<div class="modal fade" id="confirmSaveModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Save changes</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body">Are you sure you want to save these changes?</div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="cancelConfirmSave">
          Cancel
        </button>
        <button type="button" class="btn btn-danger" id="confirmSaveBtn">
          Save
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================= JS ================= -->
<script src="/js/profile.js"></script>
