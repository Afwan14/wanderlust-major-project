<% layout("/layouts/boilerplate") %>
<head>
  <!-- Authentication page specific styles -->
  <link rel="stylesheet" href="/css/auth.css" />
</head>

<!-- ========================================
     USER SIGNUP PAGE
     Account registration form for new users
     ======================================== -->
<div class="auth-wrapper">
  <div class="auth-card">
    <!-- ========================================
           PAGE HEADER
           Welcome section and signup instructions
           ======================================== -->
    <div class="text-center mb-4">
      <i class="fa-regular fa-compass auth-logo"></i>
      <!-- Page title -->
      <h2 class="text-center fw-semibold mb-1">Sign up on Wanderlust</h2>

      <!-- Subtitle -->
      <p class="text-center auth-subtitle mb-0">
        Create your account to start exploring stays
      </p>
    </div>

    <!-- ========================================
           SIGNUP FORM
           User registration with validation
           ======================================== -->
    <!-- Signup form - POST to /signup -->
    <form action="/signup" method="POST" class="needs-validation" novalidate>
        <!-- ========================================
             CREDENTIALS SECTION
             Username, email, and password fields
             ======================================== -->
        <!-- Username Input -->
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            type="text"
            name="username"
            class="form-control"
            id="username"
            required
          />
          <div class="invalid-feedback">Username is required</div>
        </div>

        <!-- Email Input -->
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            name="email"
            class="form-control"
            id="email"
            required
          />
          <div class="invalid-feedback">Please enter a valid email</div>
        </div>

        <!-- Password Input -->
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            name="password"
            class="form-control"
            id="password"
            required
            minlength="8"
            pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&#])[A-Za-z\d@$!%*?&#]+$"
            title="Password must be at least 8 characters and include uppercase, lowercase, number, and one special character (@$!%*?&#)"
          />
          <div class="form-text small">
            Must be 8+ characters with uppercase, lowercase, number, and special
            character (@$!%*?&#)
          </div>
          <div class="form-check mt-2">
            <input
              class="form-check-input toggle-password"
              type="checkbox"
              id="showSignupPassword"
              data-target="password"
            />
            <label class="form-check-label" for="showSignupPassword">
              Show password
            </label>
          </div>
          <div class="invalid-feedback">
            Enter a valid password as per the required rules
          </div>
        </div>

        <!-- Confirm Password Input -->
        <div class="mb-4">
          <label for="confirmPassword" class="form-label">
            Confirm Password
          </label>
          <input
            type="password"
            name="confirmPassword"
            class="form-control"
            id="confirmPassword"
            required
          />
          <div class="form-check mt-2">
            <input
              class="form-check-input toggle-password"
              type="checkbox"
              id="showSignupConfirmPassword"
              data-target="confirmPassword"
            />
            <label class="form-check-label" for="showSignupConfirmPassword">
              Show confirm password
            </label>
          </div>
          <div class="invalid-feedback">Passwords must match</div>
        </div>

        <!-- ========================================
             FORM SUBMISSION
             ======================================== -->
        <!-- Submit Button - Creates new user account -->
        <button class="btn btn-primary-wl w-100 py-2">Create Account</button>
    </form>

    <!-- Login Link - Redirect to login for existing users -->
    <p class="text-center small mt-3 mb-0">
      Already have an account?
      <a href="/login" class="auth-link">Log in</a>
    </p>
  </div>
</div>
