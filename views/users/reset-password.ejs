<% layout("/layouts/boilerplate") %>
<head>
  <!-- Authentication page specific styles -->
  <link rel="stylesheet" href="/css/auth.css" />
</head>

<!-- ========================================
     RESET PASSWORD PAGE
     Set new password after verification
     ======================================== -->
<div
  class="container d-flex justify-content-center align-items-center auth-min-vh"
>
  <div class="col-md-6 col-lg-5">
    <!-- Reset Password Form Card -->
    <div class="card shadow-sm rounded-4 p-4 border-0">
      <!-- Page Header -->
      <div class="text-center mb-4">
        <i class="fa-solid fa-lock-open reset-lock-icon"></i>
        <h2 class="text-center fw-semibold mb-1 mt-3">Reset Your Password</h2>
        <p class="text-center text-muted mb-0">Enter your new password below</p>
      </div>

      <!-- Password Requirements Info -->
      <div class="alert alert-info small mb-4">
        <strong>Password Requirements:</strong>
        <ul class="mb-0 mt-2 ps-3">
          <li>At least 8 characters long</li>
          <li>One uppercase letter (A-Z)</li>
          <li>One lowercase letter (a-z)</li>
          <li>One number (0-9)</li>
          <li>One special character (@$!%*?&#)</li>
        </ul>
      </div>

      <!-- Reset Password Form -->
      <form
        action="/reset-password/<%= token %>"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <!-- New Password Input -->
        <div class="mb-3">
          <label for="password" class="form-label">New Password</label>
          <input
            type="password"
            name="password"
            class="form-control"
            id="password"
            placeholder="Enter your new password"
            required
            minlength="8"
            pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&#])[A-Za-z\d@$!%*?&#]+$"
            title="Password must be at least 8 characters and include uppercase, lowercase, number, and one special character (@$!%*?&#)"
          />
          <div class="form-check mt-2">
            <input
              class="form-check-input toggle-password"
              type="checkbox"
              id="showResetPassword"
              data-target="password"
            />
            <label class="form-check-label" for="showResetPassword">
              Show password
            </label>
          </div>
          <div class="invalid-feedback">
            Enter a valid password as per the required rules
          </div>
        </div>

        <!-- Confirm Password Input -->
        <div class="mb-4">
          <label for="confirmPassword" class="form-label">
            Confirm New Password
          </label>
          <input
            type="password"
            name="confirmPassword"
            class="form-control"
            id="confirmPassword"
            placeholder="Confirm your new password"
            required
          />
          <div class="form-check mt-2">
            <input
              class="form-check-input toggle-password"
              type="checkbox"
              id="showResetConfirmPassword"
              data-target="confirmPassword"
            />
            <label class="form-check-label" for="showResetConfirmPassword">
              Show confirm password
            </label>
          </div>
          <div class="invalid-feedback">Passwords must match</div>
        </div>

        <!-- Submit Button -->
        <button class="btn btn-danger w-100 py-2">Reset Password</button>
      </form>

      <!-- Login Link -->
      <p class="text-center small mt-3 mb-0">
        Remember your password?
        <a href="/login" class="text-danger fw-semibold">Log in</a>
      </p>
    </div>
  </div>
</div>

<script src="/JS/reset-password.js"></script>
