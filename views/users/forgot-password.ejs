<% layout("/layouts/boilerplate") %>
<head>
  <!-- Authentication page specific styles -->
  <link rel="stylesheet" href="/css/auth.css" />
</head>

<!-- ========================================
     FORGOT PASSWORD PAGE
     Request password reset link
     ======================================== -->
<div class="auth-wrapper">
  <div class="auth-card">
    <!-- Page Header -->
    <div class="text-center mb-4">
      <i class="fa-solid fa-key auth-logo"></i>
      <h3 class="mt-2">Forgot Password?</h3>
      <p class="auth-subtitle small">
        No worries! Enter your email and we'll send you a reset link
      </p>
    </div>

    <!-- Forgot Password Form -->
    <form
      action="/forgot-password"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <!-- Email Input Field -->
      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input
          type="email"
          name="email"
          class="form-control"
          id="email"
          placeholder="Enter your registered email"
          required
        />
        <div class="invalid-feedback">Please enter a valid email address</div>
      </div>

      <!-- Submit Button -->
      <button class="btn btn-primary-wl w-100 mt-2">Send Reset Link</button>
    </form>

    <hr />

    <!-- Navigation Links -->
    <p class="text-center small mb-0">
      Remember your password?
      <a href="/login" class="auth-link">Log in</a>
    </p>
    <p class="text-center small mt-2 mb-0">
      Don't have an account?
      <a href="/signup" class="auth-link">Sign up</a>
    </p>
  </div>
</div>
