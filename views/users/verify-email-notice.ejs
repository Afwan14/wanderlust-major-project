<% layout("/layouts/boilerplate") %>

<head>
  <link rel="stylesheet" href="/css/auth.css" />
</head>

<!-- ========================================
     EMAIL VERIFICATION NOTICE PAGE
     Shows after signup to inform users about email verification
     ======================================== -->

<div class="auth-wrapper">
  <div class="auth-card auth-card-wide text-center">
    <div class="mb-4">
      <i class="fa-solid fa-envelope-circle-check auth-logo"></i>
      <h2 class="mt-3 mb-2">Check Your Email!</h2>
      <p class="auth-subtitle mb-1">We've sent a verification link to:</p>
      <p class="auth-email mb-0"><%= email %></p>
    </div>

    <div class="auth-info-box text-start mb-4">
      <h6 class="auth-info-title mb-3">
        <i class="fa-solid fa-circle-info"></i>
        Next Steps
      </h6>
      <ol class="mb-0 ps-3">
        <li class="mb-2">Open your email inbox</li>
        <li class="mb-2">
          Look for an email from
          <strong>Wanderlust</strong>
        </li>
        <li class="mb-2">Click the verification link in the email</li>
        <li>You'll be automatically logged in</li>
      </ol>
    </div>

    <p class="auth-muted mb-4">
      <i class="fa-regular fa-clock"></i>
      The verification link will expire in
      <strong>24 hours</strong>
    </p>

    <div class="auth-help-box text-start mb-4">
      <h6 class="mb-2">Didn't receive the email?</h6>
      <ul class="mb-3 ps-3">
        <li>Check your spam or junk folder</li>
        <li>Make sure you entered the correct email address</li>
        <li>Wait a few minutes and refresh your inbox</li>
      </ul>

      <form action="/resend-verification" method="POST" class="mt-2">
        <input type="hidden" name="email" value="<%= email %>" />
        <button type="submit" class="btn btn-outline-wl btn-sm-wl">
          <i class="fa-solid fa-paper-plane"></i>
          Resend Email
        </button>
      </form>
    </div>

    <div class="d-flex flex-column gap-2">
      <a href="/login" class="auth-link">Back to Login</a>
      <p class="small mb-0 auth-muted">
        Having trouble?
        <a href="/help" class="auth-link">Contact Support</a>
      </p>
    </div>
  </div>
</div>
