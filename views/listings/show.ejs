<% layout("/layouts/boilerplate") %>
<head>
  <!-- Listing component styles -->
  <link rel="stylesheet" href="/css/listing-cards.css" />
  <link rel="stylesheet" href="/css/card-text.css" />
  <link rel="stylesheet" href="/css/filter-bar.css" />
  <link rel="stylesheet" href="/css/hero-image.css" />
  <link rel="stylesheet" href="/css/listing-details.css" />
  <link rel="stylesheet" href="/css/review-form.css" />
  <link rel="stylesheet" href="/css/booking-card.css" />
  <link rel="stylesheet" href="/css/listing-responsive.css" />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  />

  <!-- Other styles -->
  <link rel="stylesheet" href="/css/reviews.css" />
  <link rel="stylesheet" href="/css/map.css" />
</head>

<div
  id="showPageData"
  data-listing-id="<%= listing._id %>"
  data-rating-data="<%- encodeURIComponent(JSON.stringify({
    cleanliness: ratingData.cleanliness || [],
    accuracy: ratingData.accuracy || [],
    checkIn: ratingData.checkIn || [],
    communication: ratingData.communication || [],
    location: ratingData.location || [],
    value: ratingData.value || []
  })) %>"
  data-map-token="<%= process.env.MAP_TOKEN %>"
  data-listing="<%- encodeURIComponent(JSON.stringify(listing)) %>"
  data-booking-ranges="<%- encodeURIComponent(JSON.stringify(bookingRanges || [])) %>"
  data-reserved-until="<%- encodeURIComponent(JSON.stringify(reservedUntil || null)) %>"
  data-is-reserved="<%= !!isReserved %>"
  data-share-title="<%= listing.title %>"
  hidden
></div>

<div class="container py-5 listing-page">
  <!-- HEADER SECTION -->
  <div class="listing-header-section mb-5">
    <div
      class="listing-header-top d-flex justify-content-between align-items-start flex-wrap gap-3"
    >
      <div>
        <h1 class="listing-title"><%= listing.title %></h1>
        <div
          class="listing-meta d-flex align-items-center gap-3 flex-wrap mb-3"
        >
          <% if (showRatingBadge) { %>
          <div class="rating-badge-small">
            <i class="fa-solid fa-star"></i>
            <span><%= avgRatingDisplay %></span>
            <span class="review-count">
              (<%= reviewCount %> <%= reviewCountLabelLower %>)
            </span>
          </div>
          <% } else if (showNewBadge) { %>
          <div class="rating-badge-small new-listing-badge">
            <i class="fa-regular fa-star"></i>
            <span>New</span>
          </div>
          <% } %>

          <div class="location-badge">
            <i class="fa-solid fa-location-dot"></i>
            <span>
              <%= listing.location %>
              ,
              <%= listing.country %>
            </span>
          </div>
        </div>
      </div>

      <div class="listing-actions">
        <button
          class="action-btn save-btn <%= isSaved ? 'saved' : '' %>"
          type="button"
          data-id="<%= listing._id %>"
        >
          <i class="fa-solid fa-heart"></i>
          <span><%= isSaved ? 'Saved' : 'Save' %></span>
        </button>
        <button
          class="action-btn share-btn"
          type="button"
          onclick="shareButton()"
        >
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
          <span>Share</span>
        </button>
      </div>
    </div>
  </div>

  <!-- GALLERY -->
  <div class="listing-gallery mb-5">
    <div class="listing-gallery-main">
      <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
    </div>
    <div class="listing-gallery-grid">
      <img src="<%= galleryImage1 %>" alt="<%= listing.title %>" />
      <img src="<%= galleryImage2 %>" alt="<%= listing.title %>" />
    </div>
  </div>

  <div class="listing-gallery-mobile" aria-label="Listing image gallery">
    <div class="listing-gallery-slider" id="mobileGallerySlider">
      <div class="gallery-slide">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
      </div>
      <div class="gallery-slide">
        <img src="<%= galleryImage1 %>" alt="<%= listing.title %>" />
      </div>
      <div class="gallery-slide">
        <img src="<%= galleryImage2 %>" alt="<%= listing.title %>" />
      </div>
    </div>
    <div
      class="gallery-slider-counter"
      id="mobileGalleryCounter"
      aria-live="polite"
    >
      1 / 3
    </div>
    <div
      class="gallery-slider-dots"
      id="mobileGalleryDots"
      aria-hidden="true"
    ></div>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="row align-items-start">
    <!-- LEFT COLUMN -->
    <div class="col-lg-8">
      <!-- LISTING DETAILS -->
      <div class="details-card mb-5 pb-5">
        <h2 class="details-title mb-4 desktop-guest-info">
          <i class="fa-solid fa-users"></i>
          <%= listing.maxGuests %>
          <%= guestLabel %>
          <span class="separator">·</span>
          <i class="fa-solid fa-door-open"></i>
          <%= listing.bedrooms %>
          <%= bedroomLabel %>
          <span class="separator">·</span>
          <i class="fa-solid fa-bed"></i>
          <%= listing.beds %>
          <%= bedLabel %>
          <span class="separator">·</span>
          <i class="fa-solid fa-bath"></i>
          <%= listing.bathrooms %>
          <%= bathroomLabel %>
        </h2>

        <div class="mobile-guest-grid" aria-label="Stay details">
          <div class="mobile-guest-item">
            <i class="fa-solid fa-users"></i>
            <span>
              <%= listing.maxGuests %>
              <%= guestLabel %>
            </span>
          </div>
          <div class="mobile-guest-item">
            <i class="fa-solid fa-door-open"></i>
            <span>
              <%= listing.bedrooms %>
              <%= bedroomLabel %>
            </span>
          </div>
          <div class="mobile-guest-item">
            <i class="fa-solid fa-bed"></i>
            <span>
              <%= listing.beds %>
              <%= bedLabel %>
            </span>
          </div>
          <div class="mobile-guest-item">
            <i class="fa-solid fa-bath"></i>
            <span>
              <%= listing.bathrooms %>
              <%= bathroomLabel %>
            </span>
          </div>
        </div>

        <!-- CATEGORY BADGES -->
        <div class="category-section mt-4 mb-4">
          <p class="section-label mb-2">Category</p>
          <div class="category-badges">
            <% listing.category.forEach(cat => { %>
            <span class="category-badge"><%= cat %></span>
            <% }); %>
          </div>
        </div>

        <hr class="divider" />

        <!-- DESCRIPTION -->
        <div class="description-section mt-4">
          <h3 class="section-title mb-3">About this place</h3>
          <p class="listing-description"><%= listing.description %></p>
        </div>

        <hr class="divider" />
      </div>
    </div>

    <!-- RIGHT COLUMN: BOOKING CARD -->
    <div class="col-lg-4">
      <div class="booking-card-container booking-sticky">
        <div class="booking-card">
          <div class="price-section mb-4">
            <div class="price-block">
              <div class="price-amount">
                ₹<%= listing.price.toLocaleString("en-IN") %>
              </div>
              <div class="price-label">per night</div>
            </div>
            <!-- <div class="price-divider"></div> -->
            <% if (showReservationStrip) { %>
            <div class="reservation-strip" role="status">
              <i class="fa-solid fa-ban"></i>
              <div class="reservation-text">
                <div>
                  Reserved until
                  <strong><%= reservedUntilFormatted %></strong>
                </div>
              </div>
            </div>
            <% } %>
          </div>

          <!-- OWNER VIEW -->
          <% if (showManageListing) { %>
          <a href="/listings/my" class="btn btn-manage w-100 fw-bold">
            <i class="fa-solid fa-sliders"></i>
            Manage Listing
          </a>

          <!-- LOGGED-IN USER (NOT OWNER) -->
          <% } else if (showBookingForm) { %>
          <form
            action="/listings/<%= listing._id %>/book"
            method="POST"
            class="booking-form"
            data-nightly-price="<%= listing.price %>"
          >
            <div class="date-range">
              <div class="check-in">
                <label class="form-label">Check-in</label>
                <input
                  type="text"
                  name="booking[checkIn]"
                  id="bookingCheckIn"
                  class="form-control booking-input"
                  required
                />
              </div>
              <div class="divider"></div>
              <div class="check-out">
                <label class="form-label">Check-out</label>
                <input
                  type="text"
                  name="booking[checkOut]"
                  id="bookingCheckOut"
                  class="form-control booking-input"
                  required
                />
              </div>
            </div>

            <button class="btn btn-book w-100 mt-2" type="submit">
              <i class="fa-solid fa-calendar-check"></i>
              Reserve Stay
            </button>

            <div
              class="price-breakdown"
              id="priceBreakdown"
              data-service-fee="0.08"
              data-tax-rate="0.1"
              aria-live="polite"
            ></div>
          </form>

          <!-- NOT LOGGED IN -->
          <% } else if (showLoginPrompt) { %>
          <a href="/login" class="btn btn-book w-100 mb-3">
            <i class="fa-solid fa-calendar-check"></i>
            Reserve Stay
          </a>
          <p class="text-center text-muted small">Log in to book this place</p>
          <% } %>

          <!-- BOOKING INFO -->
          <div class="booking-trust">
            <div class="trust-item">
              <i class="fa-solid fa-shield"></i>
              <span>Free cancellation within 48 hours</span>
            </div>
            <div class="trust-item">
              <i class="fa-solid fa-clock"></i>
              <span>Host responds within 1 hour</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FULL WIDTH SECTIONS BELOW BOOKING CARD -->

  <!-- ===============================
   REVIEWS SECTION (LUXURY)
================================ -->

  <% const avgHalfSteps = Math.max(0, Math.min(10, Math.round(avgRating * 2)));
  const avgFullStars = Math.floor(avgHalfSteps / 2); const avgHasHalfStar =
  avgHalfSteps % 2 === 1; const avgEmptyStars = 5 - avgFullStars -
  (avgHasHalfStar ? 1 : 0); const categoryAvg = arr => { if (!Array.isArray(arr)
  || arr.length === 0) return 0; return arr.reduce((sum, value) => sum +
  Number(value || 0), 0) / arr.length; }; const cleanlinessScore =
  categoryAvg(ratingData.cleanliness); const accuracyScore =
  categoryAvg(ratingData.accuracy); const communicationScore =
  categoryAvg(ratingData.communication); const locationScore =
  categoryAvg(ratingData.location); const valueScore =
  categoryAvg(ratingData.value); %>

  <section class="reviews-section luxury-section" id="reviewsSection">
    <header class="reviews-hero">
      <div class="reviews-hero-head">
        <h2 class="reviews-heading">Reviews</h2>
        <div class="reviews-head-rating">
          <span class="reviews-avg"><%= avgRatingDisplay %></span>
          <div
            class="review-stars review-stars-summary"
            aria-label="Average rating <%= avgRatingDisplay %> out of 5"
          >
            <% for (let i = 0; i < avgFullStars; i++) { %>
            <i class="fa-solid fa-star"></i>
            <% } %>
            <% if (avgHasHalfStar) { %>
            <i class="fa-solid fa-star-half-stroke"></i>
            <% } %>
            <% for (let i = 0; i < avgEmptyStars; i++) { %>
            <i class="fa-regular fa-star"></i>
            <% } %>
          </div>
        </div>
      </div>
      <p class="reviews-count-text">
        Based on
        <span id="reviewCount"><%= reviewCount %></span>
        <%= reviewCountLabelLower %>
      </p>
      <div class="reviews-divider" aria-hidden="true"></div>
    </header>

    <div class="reviews-trust-block">
      <div class="reviews-trust-score">
        <div class="rating-score-xl"><%= ratingScoreDisplay %></div>
        <h3 class="rating-title"><%= ratingTitle %></h3>
        <p class="rating-subtitle">Trusted feedback from verified guests.</p>
      </div>

      <div class="reviews-breakdown" aria-label="Rating breakdown">
        <div class="reviews-breakdown-row">
          <span>Cleanliness</span>
          <div class="reviews-breakdown-bar">
            <span
              class="reviews-breakdown-fill"
              data-score="<%= (cleanlinessScore * 20).toFixed(1) %>"
            ></span>
          </div>
          <strong id="cleanliness-score">
            <%= cleanlinessScore ? cleanlinessScore.toFixed(1) : "0.0" %>
          </strong>
        </div>
        <div class="reviews-breakdown-row">
          <span>Accuracy</span>
          <div class="reviews-breakdown-bar">
            <span
              class="reviews-breakdown-fill"
              data-score="<%= (accuracyScore * 20).toFixed(1) %>"
            ></span>
          </div>
          <strong id="accuracy-score">
            <%= accuracyScore ? accuracyScore.toFixed(1) : "0.0" %>
          </strong>
        </div>
        <div class="reviews-breakdown-row">
          <span>Communication</span>
          <div class="reviews-breakdown-bar">
            <span
              class="reviews-breakdown-fill"
              data-score="<%= (communicationScore * 20).toFixed(1) %>"
            ></span>
          </div>
          <strong id="communication-score">
            <%= communicationScore ? communicationScore.toFixed(1) : "0.0" %>
          </strong>
        </div>
        <div class="reviews-breakdown-row">
          <span>Location</span>
          <div class="reviews-breakdown-bar">
            <span
              class="reviews-breakdown-fill"
              data-score="<%= (locationScore * 20).toFixed(1) %>"
            ></span>
          </div>
          <strong id="location-score">
            <%= locationScore ? locationScore.toFixed(1) : "0.0" %>
          </strong>
        </div>
        <div class="reviews-breakdown-row">
          <span>Value</span>
          <div class="reviews-breakdown-bar">
            <span
              class="reviews-breakdown-fill"
              data-score="<%= (valueScore * 20).toFixed(1) %>"
            ></span>
          </div>
          <strong id="value-score">
            <%= valueScore ? valueScore.toFixed(1) : "0.0" %>
          </strong>
        </div>
      </div>
    </div>

    <!-- REVIEWS GRID (ALWAYS PRESENT) -->
    <div id="reviews" class="reviews-grid">
      <% listing.reviews.forEach(review => { const reviewHalfSteps = Math.max(0,
      Math.min(10, Math.round((review.overall || 0) * 2))); const
      reviewFullStars = Math.floor(reviewHalfSteps / 2); const reviewHasHalfStar
      = reviewHalfSteps % 2 === 1; const reviewEmptyStars = 5 - reviewFullStars
      - (reviewHasHalfStar ? 1 : 0); const reviewAuthor =
      review.author?.username || "Guest"; const reviewInitial =
      reviewAuthor.trim().charAt(0).toUpperCase() || "G"; %>
      <article class="review-card enhanced">
        <div class="review-header">
          <div class="review-avatar" aria-hidden="true">
            <%= reviewInitial %>
          </div>

          <div class="review-author-info">
            <div class="review-author-row">
              <h5 class="review-author mb-0"><%= reviewAuthor %></h5>
              <span class="review-verified-pill">
                <i class="fa-solid fa-circle-check"></i>
                Guest verified
              </span>
            </div>

            <div
              class="review-rating"
              aria-label="Rating <%= review.overall || 0 %> out of 5"
            >
              <% for (let i = 0; i < reviewFullStars; i++) { %>
              <i class="fa-solid fa-star"></i>
              <% } %>
              <% if (reviewHasHalfStar) { %>
              <i class="fa-solid fa-star-half-stroke"></i>
              <% } %>
              <% for (let i = 0; i < reviewEmptyStars; i++) { %>
              <i class="fa-regular fa-star"></i>
              <% } %>
            </div>
          </div>
        </div>

        <div
          class="review-text-wrap <%= review.hasLongComment ? 'is-collapsed' : '' %>"
        >
          <p class="review-text" data-full="<%= review.comment %>">
            <%= review.comment %>
          </p>
        </div>

        <% if (review.hasLongComment) { %>
        <button type="button" class="show-more-btn" aria-expanded="false">
          Read more
        </button>
        <% } %>

        <% if (review.canDelete) { %>
        <form
          method="POST"
          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          class="review-delete-form"
        >
          <button class="review-delete-btn" type="submit">
            <i class="fa-solid fa-trash"></i>
            <span>Delete review</span>
          </button>
        </form>
        <% } %>
      </article>
      <% }) %>
    </div>

    <!-- EMPTY STATE (VISIBLE WHEN NO REVIEWS) -->
    <% if (showNoReviews) { %>
    <div id="noReviews" class="no-reviews text-center">
      <div class="no-reviews-icon" aria-hidden="true">
        <i class="fa-regular fa-message"></i>
      </div>
      <h3>No reviews yet</h3>
      <p>Be the first to share your experience at this stay.</p>
    </div>
    <% } %>
  </section>

  <% if (showReviewCta) { %>
  <section class="review-cta">
    <h3>Stayed with us?</h3>
    <p>Share your experience with future guests.</p>
    <a
      href="/bookings/<%= reviewBooking._id %>/review"
      class="premium-review-btn"
    >
      Leave a Guest Review
    </a>
  </section>
  <% } %>

  <!-- MAP SECTION -->
  <div class="map-section luxury-section">
    <h2 class="section-title mb-4">Where you'll be</h2>
    <div id="map"></div>
  </div>

  <!-- MEET YOUR HOST SECTION -->
  <% if (showHostSection) { %>

  <div class="host-section luxury-section">
    <h2 class="section-title mb-5">Meet your host</h2>

    <div class="host-grid">
      <!-- Host Card -->
      <div class="host-card">
        <!-- Host Avatar -->
        <div class="host-avatar-area">
          <div class="host-avatar-wrap">
            <div class="host-avatar-xl" aria-hidden="true">
              <%= hostInitial %>
            </div>
            <% if (showSuperhostBadge) { %>
            <div class="host-avatar-badge" title="Superhost">
              <i class="fa-solid fa-shield"></i>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Host Info -->
        <div class="host-card-body">
          <div class="host-name-row">
            <h3 class="host-name"><%= hostFullName %></h3>
            <% if (showSuperhostBadge) { %>
            <span class="host-superhost-pill">
              <i class="fa-solid fa-star"></i>
              Superhost
            </span>
            <% } %>
          </div>

          <!-- Host Stats -->
          <div class="host-stats">
            <div class="host-stat">
              <div class="stat-value"><%= hostReviews %></div>
              <div class="stat-label">Reviews</div>
            </div>
            <div class="host-stat">
              <div class="stat-value">
                <%= hostRatingDisplay %> <% if (hasHostRating) { %>
                <i class="fa-solid fa-star text-warning ms-1"></i>
                <% } %>
              </div>
              <div class="stat-label">Rating</div>
            </div>
            <div class="host-stat">
              <div class="stat-value"><%= monthsHosting %></div>
              <div class="stat-label">Months hosting</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Host Details -->
      <div class="host-details">
        <!-- Superhost Badge -->
        <% if (showSuperhostBadge) { %>
        <div class="host-callout">
          <div class="host-callout-title">
            <i class="fa-solid fa-check-circle"></i>
            <%= hostFullName %>
            is a Superhost
          </div>
          <p class="host-callout-text">
            Superhosts are experienced, highly rated hosts who are committed to
            providing great stays for guests.
          </p>
        </div>
        <% } %>

        <!-- Host Bio -->
        <% if (showHostBio) { %>
        <div class="host-bio">
          <p><%= hostBio %></p>
        </div>
        <% } %>

        <!-- Host Details Grid -->
        <div class="host-info-grid">
          <% if (showHostWork) { %>
          <div class="host-info-item">
            <div class="host-info-icon">
              <i class="fa-solid fa-briefcase"></i>
            </div>
            <div class="host-info-content">
              <div class="host-info-title">Work</div>
              <div class="host-info-text"><%= hostWork %></div>
            </div>
          </div>
          <% } %>

          <% if (showHostEducation) { %>
          <div class="host-info-item">
            <div class="host-info-icon">
              <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="host-info-content">
              <div class="host-info-title">Education</div>
              <div class="host-info-text"><%= hostEducation %></div>
            </div>
          </div>
          <% } %>

          <% if (showHostLanguages) { %>
          <div class="host-info-item">
            <div class="host-info-icon">
              <i class="fa-solid fa-language"></i>
            </div>
            <div class="host-info-content">
              <div class="host-info-title">Languages</div>
              <div class="host-info-text"><%= hostLanguagesDisplay %></div>
            </div>
          </div>
          <% } %>

          <% if (showHostLocation) { %>
          <div class="host-info-item">
            <div class="host-info-icon">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="host-info-content">
              <div class="host-info-title">Location</div>
              <div class="host-info-text"><%= hostLocation %></div>
            </div>
          </div>
          <% } %>

          <div class="host-info-item">
            <div class="host-info-icon"><i class="fa-solid fa-clock"></i></div>
            <div class="host-info-content">
              <div class="host-info-title">Response rate</div>
              <div class="host-info-text">100%</div>
            </div>
          </div>

          <div class="host-info-item">
            <div class="host-info-icon">
              <i class="fa-solid fa-message"></i>
            </div>
            <div class="host-info-content">
              <div class="host-info-title">Responds within an hour</div>
              <div class="host-info-text">
                Usually responds in a few minutes
              </div>
            </div>
          </div>
        </div>

        <!-- Message Host Button -->
        <div id="host-message">
          <% if (showHostMessageLoginPrompt) { %>
          <a
            href="/listings/<%= listing._id %>/message-host"
            class="btn btn-outline-dark btn-lg w-100 host-message-btn"
          >
            <i class="fa-solid fa-envelope me-2"></i>
            Message host
          </a>
          <div class="text-muted small mt-2">Log in to message the host.</div>
          <% } else if (showHostMessageOwnerDisabled) { %>
          <button
            type="button"
            class="btn btn-outline-dark btn-lg w-100 host-message-btn"
            disabled
          >
            <i class="fa-solid fa-envelope me-2"></i>
            Message host
          </button>
          <div class="text-muted small mt-2">
            You are the host of this listing.
          </div>
          <% } else if (showHostMessageForm) { %>
          <button
            type="button"
            class="btn btn-outline-dark btn-lg w-100 host-message-btn"
            data-bs-toggle="collapse"
            data-bs-target="#messageHostCollapse"
            aria-expanded="false"
            aria-controls="messageHostCollapse"
          >
            <i class="fa-solid fa-envelope me-2"></i>
            Message host
          </button>

          <div class="collapse mt-3" id="messageHostCollapse">
            <form
              action="/listings/<%= listing._id %>/message-host"
              method="POST"
              class="host-message-form"
            >
              <div class="mb-2">
                <label for="hostMessage" class="form-label fw-bold">
                  Your message
                </label>
                <textarea
                  id="hostMessage"
                  name="message"
                  class="form-control"
                  rows="4"
                  placeholder="Ask about availability, check-in, or anything else..."
                  required
                ></textarea>
              </div>
              <button type="submit" class="btn btn-dark w-100">
                Send message
              </button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

