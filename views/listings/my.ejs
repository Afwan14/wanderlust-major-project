<% layout("/layouts/boilerplate") %>
<head>
  <!-- Listings grid and card specific styles -->
  <link rel="stylesheet" href="/css/listing-cards.css" />
  <link rel="stylesheet" href="/css/card-text.css" />
  <link rel="stylesheet" href="/css/listing-responsive.css" />
  <link rel="stylesheet" href="/css/my-listings-luxury.css" />
</head>

<!-- ========================================
     USER LISTINGS DASHBOARD
     ======================================== -->
<div class="container mt-4 my-listings-page">
  <section class="listings-header">
    <div class="my-listings-header-top">
      <div>
        <h1>My Listings</h1>
        <p>Manage your published stays and keep availability updated.</p>
      </div>

      <% if (myListings.length > 0) { %>
      <a href="/bookings/host/reservations" class="my-listings-host-link">
        <i class="fa-regular fa-address-book me-1"></i>
        Guest Reservations
      </a>
      <% } %>
    </div>
  </section>

  <!-- ========================================
       EMPTY STATE
       ======================================== -->
  <div
    id="empty-state"
    class="text-center text-muted mt-5 <%= myListings.length === 0 ? '' : 'd-none' %>"
  >
    <p class="fs-5">You haven’t created any listings yet.</p>
    <a href="/listings/new" class="btn btn-primary-wl mt-2 px-4">
      Create your first listing
    </a>
  </div>

  <!-- ========================================
       LISTINGS GRID
       ======================================== -->
  <% if (myListings.length > 0) { %>

  <div class="row" id="my-listings">
    <% myListings.forEach(listing => { %>

    <div
      class="col-12 col-md-6 col-lg-4 col-xl-3 mb-4"
      id="listing-<%= listing._id %>"
    >
      <div class="card listing-card my-listing-card h-100">
        <!-- CLICKABLE IMAGE + CONTENT -->
        <a
          href="/listings/<%= listing._id %>"
          class="listing-link my-listing-link"
        >
          <div class="my-listing-image-wrap">
            <img
              class="my-listing-image"
              src="<%= listing.image.url %>"
              alt="Listing image"
            />
            <div class="my-listing-image-fade"></div>
          </div>

          <div class="card-body my-listing-body">
            <h6 class="my-listing-title"><%= listing.title %></h6>

            <p class="my-listing-subtitle">Curated private stay</p>

            <p class="my-listing-price">
              ₹ <%= listing.price.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </a>

        <!-- ACTIONS -->
        <div class="my-listing-actions-wrap">
          <div class="my-listing-actions-row">
            <a
              href="/listings/<%= listing._id %>/edit"
              class="my-listing-action-btn my-listing-action-edit"
            >
              <i class="fa-regular fa-pen-to-square me-1"></i>
              Edit
            </a>

            <button
              class="my-listing-action-btn my-listing-action-delete delete-listing-btn"
              data-id="<%= listing._id %>"
              type="button"
            >
              <i class="fa-regular fa-trash-can me-1"></i>
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>

    <% }) %>
  </div>

  <% } %>
</div>
