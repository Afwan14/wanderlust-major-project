<% layout("/layouts/boilerplate") %>

<head>
  <link rel="stylesheet" href="/css/help.css" />
</head>

<section class="help-hero">
  <div class="help-hero__content">
    <p class="help-hero__eyebrow">Help Centre</p>
    <h1>How can we help you today?</h1>
    <p class="help-hero__sub">
      Browse quick answers, or reach out to the Wanderlust support team.
    </p>
    <div class="help-hero__actions">
      <a class="btn btn-primary-wl" href="#contact">Contact support</a>
      <a class="btn btn-outline-wl" href="#faqs">See FAQs</a>
    </div>
  </div>
  <div class="help-hero__card">
    <h3>Popular topics</h3>
    <ul>
      <li><a href="#bookings">Booking changes and cancellations</a></li>
      <li><a href="#hosting">Hosting basics</a></li>
      <li><a href="#payments">Payments and refunds</a></li>
      <li><a href="#trust">Trust & safety</a></li>
    </ul>
  </div>
</section>

<section class="help-sections" id="topics">
  <article class="help-section" id="bookings">
    <div class="help-section__icon">
      <i class="fa-regular fa-calendar-check"></i>
    </div>
    <div>
      <h2>Bookings</h2>
      <p>
        Need to update or cancel a reservation? Find your upcoming stays in
        <a href="/bookings">My Bookings</a>
        and manage them from there.
      </p>
      <a class="help-link" href="/bookings">Go to My Bookings</a>
    </div>
  </article>

  <article class="help-section" id="hosting">
    <div class="help-section__icon">
      <i class="fa-regular fa-building"></i>
    </div>
    <div>
      <h2>Hosting</h2>
      <p>
        Keep listings fresh, respond to guests quickly, and track reservations
        in
        <a href="/listings/my">My Listings</a>
        .
      </p>
      <a class="help-link" href="/listings/my">Go to My Listings</a>
    </div>
  </article>

  <article class="help-section" id="payments">
    <div class="help-section__icon">
      <i class="fa-regular fa-credit-card"></i>
    </div>
    <div>
      <h2>Payments & refunds</h2>
      <p>
        Refund timing depends on your bank and the listing cancellation policy.
        You can review payment summaries inside each booking.
      </p>
    </div>
  </article>

  <article class="help-section" id="trust">
    <div class="help-section__icon">
      <i class="fa-regular fa-circle-check"></i>
    </div>
    <div>
      <h2>Trust & safety</h2>
      <p>
        We verify hosts, review listings, and give you tools to report issues
        quickly.
      </p>
    </div>
  </article>
</section>

<section class="help-faq" id="faqs">
  <h2>Frequently asked questions</h2>
  <div class="help-faq__grid">
    <details>
      <summary>How do I cancel a booking?</summary>
      <p>
        Head to
        <a href="/bookings">My Bookings</a>
        , open the reservation, and choose Cancel. You will see any refund
        details before confirming.
      </p>
    </details>
    <details>
      <summary>Where can I edit my listing?</summary>
      <p>
        Open
        <a href="/listings/my">My Listings</a>
        , select the listing, and use the Edit button to update details or
        pricing.
      </p>
    </details>
    <details>
      <summary>Why is my refund taking time?</summary>
      <p>
        Refunds typically take 5-10 business days to appear, depending on your
        bank or card issuer.
      </p>
    </details>
    <details>
      <summary>How do I contact support?</summary>
      <p>Use the form below, and our team will respond within 24 hours.</p>
    </details>
  </div>
</section>

<section class="help-contact" id="contact">
  <div class="help-contact__content">
    <h2>Contact support</h2>
    <p>
      Tell us what you need help with, and we will get back to you within one
      business day.
    </p>
  </div>

  <form class="help-contact__form" method="POST" action="/help">
    <div class="row">
      <div class="col-md-6">
        <label class="form-label" for="helpName">Name</label>
        <input
          class="form-control"
          type="text"
          id="helpName"
          name="name"
          placeholder="Your full name"
          required
        />
      </div>
      <div class="col-md-6">
        <label class="form-label" for="helpEmail">Email</label>
        <input
          class="form-control"
          type="email"
          id="helpEmail"
          name="email"
          placeholder="you@example.com"
          required
        />
      </div>
    </div>
    <div class="mt-3">
      <label class="form-label" for="helpTopic">Topic</label>
      <select class="form-select" id="helpTopic" name="topic" required>
        <option value="booking">Booking support</option>
        <option value="hosting">Hosting question</option>
        <option value="payment">Payment issue</option>
        <option value="account">Account help</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="mt-3">
      <label class="form-label" for="helpMessage">Message</label>
      <textarea
        class="form-control"
        id="helpMessage"
        name="message"
        rows="5"
        placeholder="How can we help?"
        required
      ></textarea>
    </div>
    <button class="btn btn-primary-wl mt-3" type="submit">Send message</button>
  </form>
</section>
